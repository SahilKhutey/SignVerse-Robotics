# Stage 1: Build the React/Next.js Application
FROM node:20-alpine AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy monorepo configuration files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc tsconfig.base.json ./

# Copy packages and dashboard source code (exclude node_modules via .dockerignore)
COPY apps/dashboard-web ./apps/dashboard-web
COPY shared/database ./shared/database
COPY packages ./packages

# Install dependencies for the workspace
RUN pnpm install --no-frozen-lockfile

# Generate Prisma client for `@shared/database`
RUN pnpm run db:generate

# Build the Next.js app (outputs to apps/dashboard-web/out due to output: 'export')
RUN pnpm --filter dashboard-web run build

# Stage 2: Serve the built static files with Nginx
FROM nginx:alpine

# Copy the build output to replace the default nginx contents
COPY --from=builder /app/apps/dashboard-web/out /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
