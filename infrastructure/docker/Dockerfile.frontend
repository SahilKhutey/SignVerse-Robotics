# Stage 1: Base image
FROM node:20-alpine AS base
WORKDIR /app
RUN npm install -g pnpm

# Copy pnpm workspace configuration and dependencies metadata
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc tsconfig.base.json ./
COPY packages/shared-types ./packages/shared-types
COPY apps/dashboard/package.json ./apps/dashboard/package.json

# Install dependencies
RUN pnpm install --no-frozen-lockfile

# Copy dashboard source code
COPY apps/dashboard ./apps/dashboard

# Stage 2: Development server (Vite)
FROM base AS development
EXPOSE 5173
CMD ["pnpm", "--filter", "@signverse/dashboard", "run", "dev", "--host"]

# Stage 3: Builder for production
FROM base AS builder
RUN pnpm --filter @signverse/dashboard run build

# Stage 4: Production Nginx server
FROM nginx:alpine AS production
COPY infrastructure/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/dashboard/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
