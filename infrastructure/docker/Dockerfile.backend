FROM python:3.10-slim

# Install system dependencies required for OpenCV, PyTorch, and MediaPipe
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements if available, otherwise just install the known stack
# Since requirements.txt might not exist yet, we install core directly
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    websockets \
    numpy \
    torch \
    mediapipe \
    opencv-python-headless \
    pyserial \
    langchain \
    langchain-community \
    mujoco

# Copy the core Python project
COPY core /app/core
COPY backend /app/backend
COPY start_system.py /app/start_system.py

# Expose API Gateway port
EXPOSE 8000

# Set Python Path
ENV PYTHONPATH=/app

# Start the API Gateway directly via uvicorn for production
CMD ["uvicorn", "core.deployment.api_gateway.gateway:app", "--host", "0.0.0.0", "--port", "8000"]
