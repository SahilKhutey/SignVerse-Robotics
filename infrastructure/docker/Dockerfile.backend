# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: Dependency install
# ─────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS base
WORKDIR /app
RUN npm install -g pnpm

# Copy monorepo manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json .npmrc tsconfig.base.json ./

# Copy shared workspace packages that api-gateway depends on
COPY packages/shared-events    ./packages/shared-events
COPY packages/shared-security  ./packages/shared-security
COPY packages/shared-observability ./packages/shared-observability

# Copy api-gateway package manifest first for layer cache
COPY backend/api-gateway/package.json ./backend/api-gateway/package.json

# Install all workspace dependencies
RUN pnpm install --no-frozen-lockfile

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: Build (TypeScript → JavaScript)
# ─────────────────────────────────────────────────────────────────────────────
FROM base AS builder

# Copy gateway source
COPY backend/api-gateway ./backend/api-gateway

# Compile TypeScript
RUN pnpm --filter @signverse/api-gateway run build

# ─────────────────────────────────────────────────────────────────────────────
# Stage 3: Production runtime (slim)
# ─────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS production

WORKDIR /app
RUN npm install -g pnpm

# Copy monorepo shell for pnpm resolution
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY --from=base /app/packages ./packages
COPY backend/api-gateway/package.json ./backend/api-gateway/package.json

# Install production-only deps
RUN pnpm install --prod --no-frozen-lockfile

# Copy compiled gateway bundle
COPY --from=builder /app/backend/api-gateway/dist ./backend/api-gateway/dist

# Expose the gateway port
EXPOSE 8000

ENV NODE_ENV=production
ENV PORT=8000
ENV HOST=0.0.0.0

CMD ["node", "backend/api-gateway/dist/index.js"]
