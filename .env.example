VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Optional: activate a specific behavior-cloning checkpoint.
SIGNVERSE_MODEL_PATH=models/checkpoints/policy_latest.pth

# Hardware defaults. Keep simulation mode enabled when no Arduino/ESP32 is attached.
SIGNVERSE_SIMULATION_MODE=true
SIGNVERSE_SERIAL_PORT=COM3
SIGNVERSE_SERIAL_BAUD=115200

# Ingestion defaults. Keep synthetic fallback enabled for offline demos/tests.
SIGNVERSE_YOUTUBE_SYNTHETIC_FALLBACK=true
SIGNVERSE_INGEST_MAX_FRAMES=300
SIGNVERSE_INGEST_FRAME_STRIDE=1
